{
  "name": "jsa-api",
  "version": "1.0.0",
  "description": "JSA 日本留学助手 - Cloudflare Workers API",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "tail": "wrangler tail",
    "tail:staging": "wrangler tail --env staging",
    "db:seed-staging": "wrangler d1 execute jsa-db-staging --remote --file=./seed.sql",
    "db:schema-staging": "wrangler d1 execute jsa-db-staging --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
