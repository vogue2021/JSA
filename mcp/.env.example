# ═══════════════════════════════════════════════════════════════════════
# 【新需求106】JSA D1 MCP 环境变量样例
#
# ⚠️ 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# ⚠️ 更不要把 Token 写进 src/ 下任何代码文件。
# ═══════════════════════════════════════════════════════════════════════

# Cloudflare 账号 ID（Dashboard 右侧 / `npx wrangler whoami` 可见）
CLOUDFLARE_ACCOUNT_ID=784c09d5f05a8e5754657f1365345e02

# Cloudflare API Token
#   创建路径：Dashboard → My Profile → API Tokens → Create Token → Custom token
#   必需权限：Account → D1 → Edit
#   建议：单独为MCP 建一个 Token，不要复用其它用途的 Token，方便随时吊销
CLOUDFLARE_API_TOKEN=

# 目标数据库 ID（取自 workers/wrangler.toml）
#   生产 jsa-db
D1_DATABASE_ID=9e0f50c0-e85b-4eef-a5e8-f5461965d823
#   测试 jsa-db-staging（配合 JSA_MCP_TARGET=staging 使用）
D1_DATABASE_ID_STAGING=ec330b28-9f0a-4e8a-9bfc-3550eb311903

# 连哪个库：production（默认）| staging
# 强烈建议先用 staging 把 Agent 的操作流程跑通，再切生产
JSA_MCP_TARGET=staging

# 是否允许写操作。留空或 false = 只读模式（推荐日常保持只读）
# 设为 true 后，写操作仍需在每次调用时额外传 confirm=true
JSA_MCP_ALLOW_WRITE=false

# 审计日志目录，默认 mcp/logs
# JSA_MCP_LOG_DIR=
