# Environment Configuration Template
# 环境配置模板
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=localhost

# Database Configuration (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=japan_study_app

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_session_secret_key_here_at_least_32_characters_long
SESSION_MAX_AGE=604800000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Japan Study App <noreply@japanstudyapp.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3002

# Redis Configuration (optional, for session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_SCHEDULE=0 2 * * *

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3002